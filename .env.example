# Copy to .env (gitignored). NEVER commit the real token.

# Base URL of the Structs desktop app HTTP API (MCP server).
# Default '/desktop' is proxied to http://127.0.0.1:8420 by the webpack dev
# server (same-origin, avoids the CORS preflight the server rejects).
# For a remote node/paid proxy, set a full URL that supports CORS.
CELLSTRUCTS_DESKTOP_API_URL=/desktop

# Bearer token for the desktop API. Find it locally in:
#   ~/Library/Application Support/structs-app/mcp_config.json  (macOS)
CELLSTRUCTS_DESKTOP_API_TOKEN=your-token-here

# Tendermint RPC (CosmJS secondary path). '/rpc' is dev-proxied to :26657.
CELLSTRUCTS_RPC_URL=/rpc

# Optional: pin a player ID (e.g. 1-471). Empty = auto-detect via whoami.
CELLSTRUCTS_PLAYER_ID=

# Dev-proxy targets (only used by webpack-dev-server, optional overrides).
#CELLSTRUCTS_DESKTOP_PROXY_TARGET=http://127.0.0.1:8420
#CELLSTRUCTS_RPC_PROXY_TARGET=http://127.0.0.1:26657
